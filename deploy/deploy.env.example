# Параметры выкладки. Скопируйте в deploy/deploy.env и заполните — deploy.env в git не попадает.

# SSH-хост сервера (имя из ~/.ssh/config или user@адрес); вход должен быть по ключу, от root
SSH_HOST=my-vps

# адрес сайта — только чтобы в конце выкладки показать готовую ссылку на панель
SITE_URL=https://example.com

# конфиг nginx-сайта: в его server { listen 443 } добавится строка include snippets/vlesscheck.conf;
NGINX_SITE_CONF=/etc/nginx/sites-available/example.com

# префикс на сайте: панель — https://example.com/<PANEL_PREFIX>/<секрет>/, подписки — …/<PANEL_PREFIX>/sub/…
PANEL_PREFIX=checker

# необязательно: старый префикс, по которому продолжат работать выданные раньше подписки (…/<префикс>/sub/…)
LEGACY_SUB_PREFIX=
