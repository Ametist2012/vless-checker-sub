[Unit]
Description=VLESS Checker — API и панель
After=network-online.target
Wants=network-online.target

[Service]
User=vlesscheck
Group=vlesscheck
WorkingDirectory=/opt/vlesscheck/api
ExecStart=/opt/vlesscheck/api/VlessCheck.Api --urls http://127.0.0.1:8787
Environment=VLESSCHECK_DATA=/opt/vlesscheck/data
Environment=HOME=/opt/vlesscheck/data
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=always
RestartSec=5

# лимиты: на сервере работает ваш VPN, сервис не должен его задевать
MemoryHigh=120M
MemoryMax=160M
CPUWeight=50

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/vlesscheck/data

[Install]
WantedBy=multi-user.target
